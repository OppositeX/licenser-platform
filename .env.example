# ---------------------------------------------------------------------------
# Supabase — values for the "licenser" project (eu-west-1, ref=iyseueyttklbcghtwohk).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://iyseueyttklbcghtwohk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Iml5c2V1ZXl0dGtsYmNnaHR3b2hrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkwNjc0NDEsImV4cCI6MjA5NDY0MzQ0MX0.JD8agifmTvEQ8oY8U4Wbu8MGmqhoKidOJzPAiYRvaic

# Service role — pull from Supabase dashboard (Project settings → API → service_role).
# Never expose to the browser. The Supabase MCP intentionally does not return this key.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret used to sign download tokens. Generate once: `openssl rand -hex 32`.
LICENSER_SDK_HMAC_SECRET=

# ---------------------------------------------------------------------------
# WooCommerce webhook — set the same value in WC → Settings → Advanced → Webhooks → Secret.
# WITHOUT this set, /api/webhooks/woocommerce rejects ALL calls with 503 (fail-safe).
# ---------------------------------------------------------------------------
WC_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Email provider. Pick ONE — adapter probes in this order:
#   1. RESEND_API_KEY        (recommended — cheapest, fastest setup)
#   2. POSTMARK_SERVER_TOKEN
#   3. SENDGRID_API_KEY
# If none set, license emails are no-op'd (logged to events table for visibility).
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# SENDGRID_API_KEY=

# Verified sender. Must match domain configured in your provider.
LICENSER_EMAIL_FROM=Licenser <licenses@gloo.ooo>
