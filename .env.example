# ---------------------------------------------------------------------------
# Supabase — values for the "licenser" project (eu-west-1, ref=iyseueyttklbcghtwohk).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://iyseueyttklbcghtwohk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Iml5c2V1ZXl0dGtsYmNnaHR3b2hrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkwNjc0NDEsImV4cCI6MjA5NDY0MzQ0MX0.JD8agifmTvEQ8oY8U4Wbu8MGmqhoKidOJzPAiYRvaic

# Service role — pull from Supabase dashboard (Project settings → API → service_role).
# Never expose to the browser. The Supabase MCP intentionally does not return this key.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret used to sign download tokens. Generate once: `openssl rand -hex 32`.
LICENSER_SDK_HMAC_SECRET=

# ---------------------------------------------------------------------------
# WooCommerce webhook — set the same value in WC → Settings → Advanced → Webhooks → Secret.
# WITHOUT this set, /api/webhooks/woocommerce rejects ALL calls with 503 (fail-safe).
# ---------------------------------------------------------------------------
WC_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Email provider — Resend (switched from SendGrid 2026-07-23)
# Get your API key at https://resend.com/api-keys
# Verify the sender domain at Resend → Domains (add gloo.ooo, set the DNS records).
# If unset, license emails are no-op'd (logged to the events table for visibility).
RESEND_API_KEY=
# Verified sender. Must match a domain verified in Resend.
LICENSER_EMAIL_FROM=Licenser <licenses@gloo.ooo>

# ---------------------------------------------------------------------------
# Vercel Cron shared secret. Vercel sends `Authorization: Bearer <CRON_SECRET>`
# on scheduled invocations when this is set in the project env.
# UNSET in production as of 2026-09-14 — /api/cron/renewal-reminders is
# therefore reachable by anyone who finds the path. It is not failed closed
# because that would stop the daily renewal emails while the variable is
# missing; repeat calls cannot spam customers (the route skips any license
# reminded inside the 7-day window) and each unguarded run logs a warning.
# Fix: generate one (`openssl rand -hex 32`) and paste it into the Vercel
# project env. It cannot be set from this repo.
# ---------------------------------------------------------------------------
CRON_SECRET=
