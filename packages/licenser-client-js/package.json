{
  "name": "@gloo/licenser-client",
  "version": "0.1.0",
  "description": "Isomorphic TypeScript client + React hook for the Licenser platform.",
  "license": "MIT",
  "author": "Gloo Software",
  "homepage": "https://licenser.gloo.ooo",
  "repository": {
    "type": "git",
    "url": "https://github.com/gloo-software/licenser-platform.git",
    "directory": "packages/licenser-client-js"
  },
  "keywords": [
    "licensing",
    "license-key",
    "saas",
    "react",
    "wordpress",
    "licenser"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18",
    "react": "^18",
    "tsup": "^8.3.0",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
